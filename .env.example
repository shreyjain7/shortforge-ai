# ShortForge AI - optional environment overrides (copy to .env if you need them).
# Secrets such as the YouTube Data API key and OAuth client are NOT configured here:
# enter them in Settings; they are stored in Windows Credential Manager, never in files.

# Where ShortForge keeps sources, proxies, renders, models, cache and logs
# (default: %USERPROFILE%\ShortForgeData, or the folder chosen during first-run setup)
SHORTFORGE_DATA_DIR=

# Local API server (the desktop app talks to it over loopback only)
SHORTFORGE_HOST=127.0.0.1
SHORTFORGE_PORT=8756

# DEBUG | INFO | WARNING | ERROR
SHORTFORGE_LOG_LEVEL=INFO
