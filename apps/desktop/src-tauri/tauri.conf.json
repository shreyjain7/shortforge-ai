{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShortForge AI",
  "version": "0.1.0",
  "identifier": "ai.shortforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ShortForge AI",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#08090d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://127.0.0.1:8756 https:; media-src 'self' blob: http://127.0.0.1:8756; font-src 'self' data: http://127.0.0.1:8756; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8756"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Local autonomous AI Shorts studio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
